@model IEnumerable<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<h2 class="text-primary mb-4">
    DANH SÁCH THÀNH VIÊN QUẢN TRỊ
</h2>

<table class="table table-bordered table-hover">

    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Tài khoản</th>
           
            <th>Vai trò</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FullName</td>
                <td>@item.Username</td>
                <td>
                    <span class="badge bg-primary">
                        @item.Role
                    </span>
                </td>
            </tr>
        }

    </tbody>

</table>