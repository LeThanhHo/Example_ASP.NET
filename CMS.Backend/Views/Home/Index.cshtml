@model IEnumerable<CMS.Data.Entities.Order>
@{
    ViewData["Title"] = "Bảng điều khiển tổng quan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var lowStockProducts = ViewBag.LowStockProducts as List<CMS.Data.Entities.Product>;
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="letter-spacing: -0.5px;">Tổng quan hệ thống</h4>
            <p class="text-muted small mb-0">Hiệu suất vận hành kho và báo cáo doanh thu tài chính thời gian thực.</p>
        </div>
        <div class="bg-white px-3 py-2 border rounded-3 shadow-sm d-flex align-items-center gap-2" style="font-size: 13.5px;">
            <i class="bi bi-calendar3 text-primary"></i>
            <span class="text-secondary font-weight-medium">Hôm nay: <strong>@DateTime.Now.ToString("dd/MM/yyyy")</strong></span>
        </div>
    </div>

    <h6 class="text-uppercase fw-bold text-secondary mb-3 small" style="letter-spacing: 0.5px;">
        <i class="bi bi-currency-dollar text-warning me-1"></i> Báo cáo doanh thu cửa hàng
    </h6>
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white style-card border-start border-warning" style="border-width: 4px !important;">
                <span class="text-muted small fw-medium" style="font-size: 12px;">Doanh thu ngày</span>
                <h5 class="fw-bold text-danger my-1">@(((decimal)ViewBag.RevenueToday).ToString("N0")) ₫</h5>
                <small class="text-muted" style="font-size: 11px;">Hôm nay</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white style-card border-start border-warning" style="border-width: 4px !important;">
                <span class="text-muted small fw-medium" style="font-size: 12px;">Doanh thu tháng</span>
                <h5 class="fw-bold text-danger my-1">@(((decimal)ViewBag.RevenueMonth).ToString("N0")) ₫</h5>
                <small class="text-muted" style="font-size: 11px;">Tháng @DateTime.Now.Month</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white style-card border-start border-warning" style="border-width: 4px !important;">
                <span class="text-muted small fw-medium" style="font-size: 12px;">Doanh thu quý</span>
                <h5 class="fw-bold text-danger my-1">@(((decimal)ViewBag.RevenueQuarter).ToString("N0")) ₫</h5>
                <small class="text-muted" style="font-size: 11px;">Quý @(((DateTime.Now.Month - 1) / 3) + 1)</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white style-card border-start border-warning" style="border-width: 4px !important;">
                <span class="text-muted small fw-medium" style="font-size: 12px;">Doanh thu năm</span>
                <h5 class="fw-bold text-danger my-1">@(((decimal)ViewBag.RevenueYear).ToString("N0")) ₫</h5>
                <small class="text-muted" style="font-size: 11px;">Năm @DateTime.Now.Year</small>
            </div>
        </div>
    </div>

    <h6 class="text-uppercase fw-bold text-secondary mb-3 small" style="letter-spacing: 0.5px;">
        <i class="bi bi-graph-up text-primary me-1"></i> Thống kê số lượng vận hành
    </h6>
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 style-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Đơn chờ duyệt</span>
                        <h3 class="fw-bold text-dark my-1">@ViewBag.TotalNewOrders</h3>
                        <p class="text-warning small mb-0 fw-medium">Cần duyệt kho</p>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background: #eff6ff; color: #2563eb; font-size: 18px;">
                        <i class="bi bi-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 style-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Tổng Sản Phẩm</span>
                        <h3 class="fw-bold text-dark my-1">@ViewBag.TotalProducts</h3>
                        <p class="text-muted small mb-0">Thiết bị &amp; phụ kiện</p>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background: #fef2f2; color: #dc2626; font-size: 18px;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 style-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Tài khoản Thợ</span>
                        <h3 class="fw-bold text-dark my-1">@ViewBag.TotalCustomers</h3>
                        <p class="text-success small mb-0 fw-medium">Khách hàng hệ thống</p>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background: #f0fdf4; color: #16a34a; font-size: 18px;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 h-100 style-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small text-uppercase fw-bold" style="font-size: 11px;">Bài đăng mẹo</span>
                        <h3 class="fw-bold text-dark my-1">@ViewBag.TotalPosts</h3>
                        <p class="text-muted small mb-0">Tin tức &amp; Cẩm nang</p>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; background: #faf5ff; color: #9333ea; font-size: 18px;">
                        <i class="bi bi-file-earmark-richtext"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 bg-white h-100">
                <div class="card-header bg-transparent border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Đơn hàng vừa phát sinh</h6>
                    <a href="@Url.Action("Index", "Order")" class="btn btn-link p-0 text-decoration-none small font-weight-bold">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 13.5px;">
                            <thead class="table-light text-secondary small text-uppercase" style="font-size: 11.5px;">
                                <tr>
                                    <th class="ps-3" style="width: 100px;">Mã Đơn</th>
                                    <th>Khách hàng / Đối tác</th>
                                    <th>Trạng thái</th>
                                    <th class="pe-3 text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">Hiện tại hệ thống chưa ghi nhận đơn đặt hàng nào.</td>
                                    </tr>
                                }
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-secondary">#@order.Id</td>
                                        <td>
                                            <div class="fw-bold text-dark">@(order.Customer?.FullName ?? "Tài khoản vãng lai")</div>
                                            <small class="text-muted">@order.Customer?.Email</small>
                                        </td>
                                        <td>
                                            @if (order.Status == 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 rounded-pill" style="font-size: 11px;">Chờ duyệt</span>
                                            }
                                            else if (order.Status == 1)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill" style="font-size: 11px;">Đang giao</span>
                                            }
                                            else if (order.Status == 2)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill" style="font-size: 11px;">Hoàn tất</span>
                                            }
                                        </td>
                                        <td class="pe-3 text-end">
                                            <a href="@Url.Action("Details", "Order", new { id = order.Id })" class="btn btn-sm btn-light border fw-semibold px-2">Duyệt đơn</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-lightning-charge text-warning me-2"></i>Thao tác nhanh</h6>
                </div>
                <div class="card-body d-flex flex-column gap-2">
                    <a href="@Url.Action("Create", "Product")" class="btn btn-outline-primary btn-sm w-100 text-start py-2 px-3 rounded-2 fw-medium d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-plus-circle me-2"></i>Đăng thiết bị mới</span>
                        <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3 bg-white">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Cảnh báo hàng sắp hết</h6>
                </div>
                <div class="card-body p-3">
                    @if (lowStockProducts == null || !lowStockProducts.Any())
                    {
                        <div class="text-center text-muted small py-2">Mọi thiết bị đều đủ số lượng cung ứng đạt chuẩn.</div>
                    }
                    else
                    {
                        @foreach (var prod in lowStockProducts)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 rounded-2 bg-light mb-2" style="font-size: 13px;">
                                <span class="text-dark fw-medium text-truncate mr-2" style="max-width: 170px;">@prod.Name</span>
                                <span class="badge @(prod.StockQuantity == 0 ? "bg-danger text-white" : "bg-warning text-dark") rounded-1">Còn @prod.StockQuantity máy</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .style-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .style-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.05) !important;
        }

    .bg-warning-subtle {
        background-color: #fffbeb;
    }

    .text-warning {
        color: #d97706 !important;
    }

    .border-warning-subtle {
        border-color: #fde68a !important;
    }

    .bg-success-subtle {
        background-color: #f0fdf4;
    }

    .text-success {
        color: #16a34a !important;
    }

    .border-success-subtle {
        border-color: #bbf7d0 !important;
    }

    .bg-primary-subtle {
        background-color: #f0f9ff;
    }

    .text-primary {
        color: #0284c7 !important;
    }

    .border-primary-subtle {
        border-color: #bae6fd !important;
    }
</style>