@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Chỉnh sửa Sản phẩm";
}

<div class="d-flex align-items-center mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <h4 class="fw-bold mb-0">
        <i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa Sản phẩm
    </h4>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Vui lòng kiểm tra lại thông tin:</strong>
        <ul class="mb-0 mt-1">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold">Thông tin sản phẩm</h6>
            </div>
            <div class="card-body p-4">
                @* 💡 ĐÃ BỔ SUNG: enctype="multipart/form-data" để Controller nhận được file ảnh mới *@
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Tên sản phẩm <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">
                                Giá bán (₫) <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Price" type="number" min="0" step="1000"
                                   class="form-control" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StockQuantity" class="form-label fw-semibold">
                                Số lượng tồn kho <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StockQuantity" type="number" min="0"
                                   class="form-control" />
                            <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3 mt-3">
                        <label asp-for="CategoryProductId" class="form-label fw-semibold">
                            Danh mục <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CategoryProductId" asp-items="ViewBag.Categories"
                                class="form-select">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryProductId" class="text-danger small"></span>
                    </div>

                    @* 💡 ĐÃ THAY ĐỔI: Chuyển đổi từ input nhập URL thành ô chọn tệp hình ảnh mới *@
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Thay đổi hình ảnh sản phẩm</label>
                        <input type="file" name="imageFile" class="form-control"
                               accept="image/*" onchange="previewImage(this)" />
                        <small class="text-muted d-block mt-1">Để trống nếu bạn muốn giữ nguyên hình ảnh hiện tại.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning px-4 font-weight-bold">
                            <i class="bi bi-save me-1"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-lg me-1"></i> Hủy
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    @* Khối Preview hiển thị ảnh hiện tại hoặc ảnh mới vừa tải lên *@
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-semibold">Xem trước hình ảnh</h6>
            </div>
            <div class="card-body text-center p-4">
                @* Nếu sản phẩm chưa có sẵn ảnh, hiển thị placeholder này *@
                <div id="imagePlaceholder" class="text-muted"
                     style="display: @(string.IsNullOrEmpty(Model.ImageUrl) ? "block" : "none")">
                    <i class="bi bi-image" style="font-size:3rem; opacity:0.3;"></i>
                    <p class="small mt-2">Chưa có hình ảnh minh họa</p>
                </div>

                @* Nếu đã có ảnh sẵn từ database, hiển thị thẳng lên thông qua Model *@
                <img id="previewImg" src="@Model.ImageUrl" alt="Preview"
                     class="img-fluid rounded shadow-sm @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")"
                     style="max-height:220px; object-fit:contain; padding: 10px; background-color: #f8fafc;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Lưu đường dẫn ảnh gốc từ database làm bộ nhớ đệm
        const originalImageUrl = "@Model.ImageUrl";

        // 💡 THUẬT TOÁN: Đọc tệp ảnh mới và thay thế màn hình preview cục bộ
        function previewImage(input) {
            const img = document.getElementById('previewImg');
            const placeholder = document.getElementById('imagePlaceholder');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    placeholder.style.display = 'none';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                // Nếu người dùng hủy chọn tệp, trả lại ảnh gốc của sản phẩm
                if (originalImageUrl.trim()) {
                    img.src = originalImageUrl;
                    img.classList.remove('d-none');
                    placeholder.style.display = 'none';
                } else {
                    img.classList.add('d-none');
                    placeholder.style.display = 'block';
                    img.src = "";
                }
            }
        }
    </script>
}