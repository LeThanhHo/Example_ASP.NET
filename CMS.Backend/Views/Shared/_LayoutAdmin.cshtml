<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeThanhHo Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-width: 260px;
            --sidebar-bg: #0b111e;
            --sidebar-hover: #151e2e;
            --sidebar-active: rgba(59, 130, 246, 0.1);
            --accent: #3b82f6;
            --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            --text-muted: #64748b;
            --text-light: #94a3b8;
            --border: rgba(255, 255, 255, 0.05);
            --topbar-h: 65px;
            --card-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05);
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Be Vietnam Pro', sans-serif;
            background: #f8fafc;
            margin: 0;
            min-height: 100vh;
            color: #1e293b;
        }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--sidebar-bg);
            display: flex;
            flex-direction: column;
            z-index: 1000;
            overflow: hidden;
            box-shadow: 4px 0 24px rgba(0,0,0,0.15);
        }

            /* Hiệu ứng Radial Glow góc trên Sidebar */
            .sidebar::before {
                content: '';
                position: absolute;
                top: -60px;
                left: -60px;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, transparent 70%);
                pointer-events: none;
            }

        /* Brand Header */
        .sidebar-brand {
            padding: 22px 24px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

            .sidebar-brand .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

        .brand-icon {
            width: 38px;
            height: 38px;
            background: var(--accent-gradient);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justifyContent: center;
            font-size: 18px;
            color: white;
            box-shadow: 0 4px 14px rgba(59,130,246,0.4);
            flex-shrink: 0;
        }

        .brand-text {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.3px;
            line-height: 1.2;
        }

        .brand-sub {
            font-size: 10px;
            color: var(--text-muted);
            font-weight: 500;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            margin-top: 1px;
        }

        /* Sidebar Nav */
        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 12px 0;
        }

            .sidebar-nav::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-nav::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.08);
                border-radius: 4px;
            }

        .nav-section-label {
            font-size: 10.5px;
            font-weight: 700;
            color: #475569;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 16px 24px 6px;
        }

        .nav-item-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 18px;
            margin: 2px 12px;
            border-radius: 8px;
            color: #94a3b8;
            text-decoration: none;
            font-size: 13.5px;
            font-weight: 500;
            transition: all 0.2s ease;
            position: relative;
        }

            .nav-item-link:hover {
                background: var(--sidebar-hover);
                color: #f8fafc;
                transform: translateX(2px);
            }

            .nav-item-link.active {
                background: var(--sidebar-active);
                color: #3b82f6;
                font-weight: 600;
            }

                .nav-item-link.active::before {
                    content: '';
                    position: absolute;
                    left: -12px;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 4px;
                    height: 20px;
                    background: var(--accent);
                    border-radius: 0 4px 4px 0;
                    box-shadow: 2px 0 8px var(--accent);
                }

            .nav-item-link i {
                font-size: 16px;
                width: 20px;
                text-align: center;
                flex-shrink: 0;
                transition: transform 0.2s;
            }

            .nav-item-link:hover i {
                transform: scale(1.1);
            }

        /* Sidebar Footer Logout */
        .sidebar-footer {
            padding: 16px 14px;
            border-top: 1px solid var(--border);
            flex-shrink: 0;
            background: rgba(0, 0, 0, 0.1);
        }

        .btn-logout {
            display: flex;
            align-items: center;
            justifyContent: center;
            gap: 8px;
            width: 100%;
            padding: 10px;
            background: rgba(239, 68, 68, 0.06);
            border: 1px solid rgba(239, 68, 68, 0.15);
            border-radius: 8px;
            color: #f87171;
            text-decoration: none;
            font-size: 13px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-logout:hover {
                background: #ef4444;
                color: white;
                box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
                border-color: #ef4444;
            }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            height: var(--topbar-h);
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            align-items: center;
            justifyContent: space-between;
            padding: 0 32px;
            z-index: 900;
            box-shadow: 0 1px 3px rgb(0 0 0 / 0.01);
        }

        .topbar-title {
            font-size: 17px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.2px;
        }

        /* 💡 KHỐI MỚI: Panel thông báo Tên & Vai trò khi đăng nhập ở Topbar bên phải */
        .topbar-user-panel {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 6px 14px 6px 8px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 30px;
            transition: all 0.2s ease;
        }

            .topbar-user-panel:hover {
                background: #f1f5f9;
                border-color: #cbd5e1;
            }

        .topbar-avatar-wrapper {
            position: relative;
        }

        .topbar-avatar {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justifyContent: center;
            font-size: 13px;
            color: white;
            font-weight: 700;
            box-shadow: 0 2px 6px rgba(124,58,237,0.25);
        }

        .status-indicator {
            position: absolute;
            bottom: -1px;
            right: -1px;
            width: 10px;
            height: 10px;
            background: #22c55e;
            border: 2px solid #fff;
            border-radius: 50%;
        }

        .topbar-user-info {
            line-height: 1.3;
        }

        .topbar-user-name {
            font-size: 13px;
            font-weight: 600;
            color: #1e293b;
        }

        .topbar-user-role {
            font-size: 10px;
            font-weight: 700;
            color: #2563eb;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            display: block;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-width);
            margin-top: var(--topbar-h);
            padding: 32px;
            min-height: calc(100vh - var(--topbar-h));
        }

        /* Responsive di động */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }

                .sidebar.open {
                    transform: translateX(0);
                }

            .topbar, .main-content {
                left: 0;
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-brand">
            <a class="brand-logo" asp-controller="Home" asp-action="Index">
                <div class="brand-icon"><i class="bi bi-layers-fill"></i></div>
                <div>
                    <div class="brand-text">LeThanhHo</div>
                    <div class="brand-sub">CMS Dashboard</div>
                </div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Tổng quan</div>
            <a class="nav-item-link" asp-controller="Home" asp-action="Index">
                <i class="bi bi-speedometer2"></i> Bảng điều khiển
            </a>

            <div class="nav-section-label">Nội dung</div>
            <a class="nav-item-link" asp-controller="Category" asp-action="Index">
                <i class="bi bi-grid-3x3-gap"></i> Quản lý Danh mục
            </a>
            <a class="nav-item-link" asp-controller="Post" asp-action="Index">
                <i class="bi bi-file-earmark-richtext"></i> Quản lý Bài viết
            </a>

            <div class="nav-section-label">Thương mại</div>
            <a class="nav-item-link" asp-controller="CategoryProduct" asp-action="Index">
                <i class="bi bi-tag"></i> Danh mục Sản phẩm
            </a>
            <a class="nav-item-link" asp-controller="Product" asp-action="Index">
                <i class="bi bi-box-seam"></i> Sản phẩm
            </a>
            <a class="nav-item-link" asp-controller="Customer" asp-action="Index">
                <i class="bi bi-person-lines-fill"></i> Khách hàng
            </a>
            <a class="nav-item-link" asp-controller="Order" asp-action="Index">
                <i class="bi bi-receipt"></i> Đơn hàng
            </a>

            <div class="nav-section-label">Hệ thống</div>
            <a class="nav-item-link" asp-controller="User" asp-action="Index">
                <i class="bi bi-people-fill"></i> Quản lý Thành viên
            </a>
            <a class="nav-item-link" asp-controller="Banner" asp-action="Index">
                <i class="bi bi-images"></i> Quản lý Banner
            </a>
        </nav>

        <div class="sidebar-footer">
            <a class="btn-logout" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-left"></i> Đăng xuất
            </a>
        </div>
    </aside>

    <header class="topbar d-flex align-items-center justify-content-between">
        <div class="topbar-title">@(ViewData["Title"] ?? "Bảng điều khiển hệ thống")</div>

        @if (User.Identity.IsAuthenticated)
        {
            <div class="ms-auto ml-auto text-end small text-secondary d-flex align-items-center justify-content-end" style="font-size: 13.5px; gap: 8px;">
                <i class="bi bi-circle-fill" style="font-size: 7px; color: #22c55e;" title="Online"></i>
                <span>
                    Xin chào <strong class="text-dark">@User.FindFirst("FullName")?.Value</strong>,
                    Vai trò: <span class="badge bg-light text-primary border font-weight-bold" style="padding: 4px 8px; font-size: 12px;">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </span>
            </div>
        }
    </header>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Thuật toán quét và Highlight Menu động dựa trên URL trình duyệt
        const path = window.location.pathname.toLowerCase();
        document.querySelectorAll('.nav-item-link').forEach(link => {
            const href = link.getAttribute('href')?.toLowerCase();
            if (href && (path === href || (path.startsWith(href) && href !== '/'))) {
                link.classList.add('active');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>