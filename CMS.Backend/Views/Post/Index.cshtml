@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Danh sách bài viết";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="fw-bold text-dark">
            DANH SÁCH BÀI VIẾT
        </h1>

        <a href="/Post/Create" class="btn btn-success">
            ⨁ Thêm bài viết mới
        </a>

    </div>

    <!-- Danh sách bài viết -->
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card h-100 shadow-sm border-0">

                    <!-- Hình ảnh -->
                    <img src="@item.ImageUrl"
                         class="card-img-top"
                         style="height: 200px; object-fit: cover;"
                         alt="Thumbnail">

                    <div class="card-body">

                        <!-- Category -->
                        <span class="badge bg-info text-dark mb-2">
                            @item.Category?.Name
                        </span>

                        <!-- Title -->
                        <h4 class="card-title text-primary">
                            @item.Title
                        </h4>

                        <!-- Content -->
                        <p class="card-text text-secondary text-truncate">
                            @item.Content
                        </p>

                        <!-- Date -->
                        <p class="text-muted">
                            Ngày đăng:
                            @item.CreatedDate.ToString("dd/MM/yyyy")
                        </p>

                        <!-- Button -->
                        <div class="d-flex gap-2">

                            <a href="/Post/Details/@item.Id"
                               class="btn btn-outline-primary btn-sm">
                                Xem chi tiết
                            </a>

                            <a href="/Post/Edit/@item.Id"
                               class="btn btn-outline-warning btn-sm">
                                Sửa
                            </a>

                            <a href="/Post/Delete/@item.Id"
                               class="btn btn-outline-danger btn-sm">
                                🗑 Xóa
                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

</div>