@{
    Layout = "_LayoutAdmin";
}

@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Thêm Bài Viết Mới";
}

<div class="container mt-4" style="max-width: 760px;">

    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h2 class="mb-0 text-primary fw-bold">
            <i class="bi bi-file-earmark-plus me-2"></i>Thêm Bài Viết Mới
        </h2>
    </div>

    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Vui lòng kiểm tra lại thông tin:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            @* 💡 ĐÃ BỔ SUNG: enctype="multipart/form-data" để hỗ trợ upload tệp ảnh bài viết *@
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">
                        Tiêu đề <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control"
                           placeholder="Nhập tiêu đề bài viết..." autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">
                        Danh mục <span class="text-danger">*</span>
                    </label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                @* 💡 ĐÃ THAY ĐỔI: Chuyển đổi từ input nhập link URL sang input chọn file *@
                <div class="mb-3">
                    <label class="form-label fw-semibold">Hình ảnh đại diện bài viết</label>
                    <input type="file" name="imageFile" class="form-control"
                           accept="image/*" onchange="previewImage(this)" />

                    {/* Khung hiển thị ảnh xem trước ngay khi chọn file */}
                    <div id="imagePreview" class="mt-2" style="display:none;">
                        <img id="previewImg" src="" alt="Preview"
                             class="img-thumbnail" style="max-height:160px; object-fit: cover;" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold">
                        Nội dung <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Content" class="form-control"
                              rows="8" placeholder="Nhập nội dung bài viết..."></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i> Lưu bài viết
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-lg me-1"></i> Hủy bỏ
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // 💡 THUẬT TOÁN: Đọc file ảnh offline và hiển thị preview trực tiếp trên trình duyệt
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const img = document.getElementById('previewImg');

            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                preview.style.display = 'none';
                img.src = "";
            }
        }
    </script>
}