@{
    Layout = "_LayoutAdmin";
}

@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chỉnh Sửa Bài Viết";
}

<div class="container mt-4" style="max-width: 760px;">

    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h2 class="mb-0 text-warning fw-bold">
            <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Bài Viết
        </h2>
    </div>

    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Vui lòng kiểm tra lại thông tin:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">
                        Tiêu đề <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold">
                        Danh mục <span class="text-danger">*</span>
                    </label>
                    <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Thay đổi hình ảnh đại diện</label>
                    <input type="file" name="imageFile" class="form-control"
                           accept="image/*" onchange="previewImage(this)" />
                    <small class="text-muted d-block mt-1">Để trống nếu bạn muốn giữ nguyên hình ảnh hiện tại.</small>

                    <div id="imagePreview" class="mt-2"
                         style="display: @(string.IsNullOrEmpty(Model.ImageUrl) ? "none" : "block")">
                        <img id="previewImg" src="@Model.ImageUrl" alt="Preview"
                             class="img-thumbnail" style="max-height:160px; object-fit: cover;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-semibold">
                        Nội dung <span class="text-danger">*</span>
                    </label>
                    @* 💡 ĐÃ THAY ĐỔI: Thêm id="editor" để JavaScript kích hoạt CKEditor *@
                    <textarea asp-for="Content" id="editor" class="form-control" rows="8"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-muted">Ngày tạo</label>
                    <input type="text" class="form-control"
                           value="@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")" readonly />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4 font-weight-bold text-dark fw-bold">
                        <i class="bi bi-save me-1"></i> Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-lg me-1"></i> Hủy bỏ
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    @* Tải thư viện CKEditor 5 Classic *@
    <script src="https://cdn.jsdelivr.net/npm/@@ckeditor/ckeditor5-build-classic@41.0.0/build/ckeditor.js"></script>

    <script>
        // 1️⃣ Cấu hình khởi tạo CKEditor 5
        ClassicEditor
            .create(document.querySelector('#editor'), {
                placeholder: 'Cập nhật lại nội dung bài viết chi tiết tại đây...',
                toolbar: [
                    'heading', '|',
                    'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|',
                    'blockQuote', 'insertTable', 'undo', 'redo'
                ]
            })
            .then(editor => { console.log('CKEditor 5 loaded!', editor); })
            .catch(error => { console.error('Lỗi nạp CKEditor:', error); });

        // 2️⃣ MẸO CHÍ MẠNG: Đánh lừa bộ kiểm duyệt Server-side ngầm của C#
        // Bắt sự kiện trước khi Form gửi dữ liệu đi sang Controller
        $('form').on('submit', function (e) {
            const fileInput = $("input[name='imageFile']")[0];

            // Nếu admin không chọn tệp ảnh mới (danh sách file bằng 0)
            if (fileInput && fileInput.files.length === 0) {
                // Tạo một file ảnh giả lập dung lượng 0 byte tên là "no-image.jpg"
                const blob = new Blob([""], { type: "image/jpeg" });
                const mockFile = new File([blob], "no-image.jpg", { type: "image/jpeg" });

                // Dùng DataTransfer để nhét file giả này vào ô input
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(mockFile);
                fileInput.files = dataTransfer.files;

                console.log("Đã kích hoạt Mock File để vượt qua Server-side Validation!");
            }
        });

        // 3️⃣ Thuật toán xử lý ảnh xem trước (Preview) cũ của Hồ
        const originalImageUrl = "@Model?.ImageUrl";
        function previewImage(input) {
            const preview = document.getElementById('imagePreview');
            const img = document.getElementById('previewImg');

            if (input.files && input.files[0]) {
                // Nếu file được chọn là file giả do script tự tạo, không hiển thị preview lại làm gì
                if(input.files[0].name === "no-image.jpg" && input.files[0].size === 0) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                if (originalImageUrl && originalImageUrl.trim() !== '') {
                    img.src = originalImageUrl;
                    preview.style.display = 'block';
                } else {
                    preview.style.display = 'none';
                    img.src = "";
                }
            }
        }
    </script>

    <style>
        .ck-editor__editable_inline {
            min-height: 320px;
            border-bottom-left-radius: 0.375rem !important;
            border-bottom-right-radius: 0.375rem !important;
        }

        .ck-editor__top {
            border-top-left-radius: 0.375rem !important;
            border-top-right-radius: 0.375rem !important;
        }
    </style>
}