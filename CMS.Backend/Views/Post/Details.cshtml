@{
    Layout = "_LayoutAdmin";
}

@model CMS.Data.Entities.Post

<div class="container mt-4">

    <div class="card shadow">

        <img src="@Model.ImageUrl"
             class="card-img-top"
             style="height:400px; object-fit:cover;">

        <div class="card-body">

            <span class="badge bg-info text-dark mb-2">
                @Model.Category?.Name
            </span>

            <h1 class="text-primary fw-bold">
                @Model.Title
            </h1>

            <p class="text-muted">
                Ngày đăng:
                @Model.CreatedDate.ToString("dd/MM/yyyy")
            </p>

            <hr />

            @* 💡 ĐÃ SỬA: Sử dụng Html.Raw để render chuỗi HTML từ CKEditor một cách chuẩn chỉ *@
            <div style="line-height: 30px; font-size:18px;" class="post-rich-text-content">
                @Html.Raw(Model.Content)
            </div>

            <a href="/Post/Index"
               class="btn btn-secondary mt-3">
                ← Quay lại
            </a>

        </div>

    </div>

</div>