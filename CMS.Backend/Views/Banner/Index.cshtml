@model IEnumerable<CMS.Data.Entities.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Quản lý Banner</h4>
        <small class="text-muted">Tổng: @Model.Count() banner</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Thêm banner
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-image text-muted" style="font-size:3rem; opacity:0.4;"></i>
            <p class="mt-3 text-muted mb-0">
                Chưa có banner nào.
                <a asp-action="Create" class="text-primary">Thêm ngay</a>
            </p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px" class="text-center">Thứ tự</th>
                        <th style="width:140px">Ảnh</th>
                        <th>Tiêu đề</th>
                        <th>Link</th>
                        <th style="width:100px" class="text-center">Trạng thái</th>
                        <th style="width:150px" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center">
                                <span class="badge bg-secondary">@item.DisplayOrder</span>
                            </td>
                            <td>
                                <img src="@item.ImageUrl" alt="@item.Title"
                                     style="width:120px;height:60px;object-fit:cover;border-radius:6px;" />
                            </td>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="text-muted small">
                                @(string.IsNullOrEmpty(item.LinkUrl) ? "—" : item.LinkUrl)
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    @if (item.IsActive)
                                    {
                                        <button type="submit" class="btn btn-success btn-sm" title="Đang hiển thị - bấm để ẩn">
                                            <i class="bi bi-eye-fill"></i> Hiện
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline-secondary btn-sm" title="Đang ẩn - bấm để hiện">
                                            <i class="bi bi-eye-slash"></i> Ẩn
                                        </button>
                                    }
                                </form>
                            </td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm me-1" title="Sửa">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Xóa banner \'@item.Title\'?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="text-muted small mt-2">
        <i class="bi bi-info-circle me-1"></i>
        Banner có số thứ tự nhỏ sẽ hiển thị trước trên trang chủ. Chỉnh "Thứ tự" trong form Sửa để thay đổi.
    </div>
}
