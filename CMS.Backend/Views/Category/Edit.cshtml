@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chỉnh Sửa Danh Mục";
}

<div class="container mt-4" style="max-width: 680px;">

    <div class="d-flex align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h2 class="mb-0 text-warning fw-bold">
            <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Danh Mục
        </h2>
    </div>

    <hr />

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Vui lòng kiểm tra lại thông tin:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                @* Giữ lại Id để controller nhận đúng record *@
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold">
                        Tên danh mục <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name"
                           class="form-control @(ViewData.ModelState["Name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                           placeholder="Ví dụ: Tin Giáo Dục, Công Nghệ..."
                           autocomplete="off" />
                    <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                    <div class="form-text text-muted">Tối đa 100 ký tự.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold">
                        Mô tả <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Description"
                              class="form-control @(ViewData.ModelState["Description"]?.Errors.Count > 0 ? "is-invalid" : "")"
                              rows="4"
                              placeholder="Mô tả ngắn về danh mục này..."></textarea>
                    <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
                    <div class="form-text text-muted">Tối đa 500 ký tự.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">
                        <i class="bi bi-save me-1"></i> Cập nhật
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-x-lg me-1"></i> Hủy bỏ
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
