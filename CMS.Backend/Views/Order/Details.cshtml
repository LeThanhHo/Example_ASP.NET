@model CMS.Data.Entities.Order
@{
    ViewData["Title"] = "Chi tiết hóa đơn #" + Model.Id;
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    decimal totalOrderPrice = 0;
}

<div class="container-fluid px-4 py-3">
    <div class="mb-3">
        <a href="@Url.Action("Index", "Order")" class="btn btn-link p-0 text-decoration-none text-secondary font-weight-bold small">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách đơn
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-light border-bottom py-3">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-shopping-cart mr-2 text-secondary"></i>Thiết bị cơ khí trong đơn hàng</h6>
                </div>
                <div class="card-body">
                    <table class="table align-middle border-bottom">
                        <thead class="bg-light small font-weight-bold text-uppercase text-secondary">
                            <tr>
                                <th>Sản phẩm</th>
                                <th style="width: 120px;" class="text-right">Đơn Giá</th>
                                <th style="width: 100px;" class="text-center">Số Lượng</th>
                                <th style="width: 150px;" class="text-right">Thành Tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var detail in Model.OrderDetails)
                            {
                                decimal subTotal = detail.Quantity * detail.UnitPrice;
                                totalOrderPrice += subTotal;
                                <tr>
                                    <td>
                                        <div class="font-weight-bold text-dark" style="font-size: 14.5px;">@detail.Product?.Name</div>
                                        <small class="text-muted">Mã linh kiện: #@detail.ProductId</small>
                                    </td>
                                    <td class="text-right font-weight-bold text-secondary">@detail.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-center font-weight-bold text-dark">@detail.Quantity</td>
                                    <td class="text-right font-weight-bold text-danger">@subTotal.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-right py-2 px-3 bg-light rounded border d-flex justify-content-between align-items-center">
                        <span class="font-weight-bold text-secondary">TỔNG GIÁ TRỊ ĐƠN HÀNG:</span>
                        <span class="h4 font-weight-bold text-danger m-0">@totalOrderPrice.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm border-0 bg-white mb-4">
                <div class="card-header bg-light border-bottom py-3">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-user-tie mr-2 text-secondary"></i>Thông tin đối tác thợ mua máy</h6>
                </div>
                <div class="card-body" style="font-size: 14px;">
                    <p class="mb-2">
                        <i class="fas fa-user text-muted mr-2" style="width: 16px;"></i>
                        Họ tên: <strong>@Model.Customer?.FullName</strong>
                    </p>

                    <p class="mb-2">
                        <i class="fas fa-envelope text-muted mr-2" style="width: 16px;"></i>
                        Email tài khoản: <span class="text-secondary">@(Model.Customer?.Email?? Model.Customer?.Email)</span>
                    </p>

                    <p class="mb-2">
                        <i class="fas fa-phone-alt text-muted mr-2" style="width: 16px;"></i>
                        Số điện thoại: <strong class="text-dark">@(string.IsNullOrEmpty(Model.Customer?.Phone) ? "Chưa cập nhật" : Model.Customer.Phone)</strong>
                    </p>

                    <p class="mb-3">
                        <i class="fas fa-map-marker-alt text-warning mr-2" style="width: 16px;"></i>
                        Địa chỉ nhận hàng: <span class="text-secondary">@(string.IsNullOrEmpty(Model.Customer?.Address) ? "Chưa cập nhật địa chỉ" : Model.Customer.Address)</span>
                    </p>

                    <hr class="my-2" />

                    <p class="mb-0">
                        <i class="fas fa-comment-alt text-muted mr-2" style="width: 16px;"></i>
                        Ghi chú từ thợ: <span class="text-muted font-italic">@(string.IsNullOrEmpty(Model.Notes) ? "Không có ghi chú đặc biệt." : Model.Notes)</span>
                    </p>
                </div>
            </div>

            <div class="card shadow-sm border-0 bg-white">
                <div class="card-header bg-light border-bottom py-3">
                    <h6 class="m-0 font-weight-bold text-dark"><i class="fas fa-sliders-h mr-2 text-secondary"></i>Quyết định trạng thái đơn</h6>
                </div>
                <div class="card-body">
                    <div class="mb-3 small text-muted">
                        Trạng thái hiện tại:
                        @if (Model.Status == 0)
                        {
                            <span class="badge badge-warning text-white">CHỜ DUYỆT</span>
                        }
                        else if (Model.Status == 1)
                        {

                            <span class="badge badge-primary">ĐANG GIAO HÀNG</span>
                        }
                        else if (Model.Status == 2)
                        {

                            <span class="badge badge-success">ĐÃ HOÀN THÀNH</span>
                        }
                    </div>

                    <form action="@Url.Action("UpdateStatus", "Order")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="form-group mb-3">
                            <label class="form-label font-weight-bold small text-secondary">Cập nhật tiến trình:</label>
                            <select name="status" class="form-control form-control-sm">
                                <option value="0" selected="@(Model.Status == 0)">0 - Đơn hàng chờ kiểm kho</option>
                                <option value="1" selected="@(Model.Status == 1)">1 - Đơn hàng xuất kho đang giao</option>
                                <option value="2" selected="@(Model.Status == 2)">2 - Đã thu tiền / Hoàn tất giao máy</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-warning text-white btn-sm btn-block font-weight-bold text-uppercase py-2 shadow-sm">
                            <i class="fas fa-save mr-1"></i> Ghi nhận thay đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>